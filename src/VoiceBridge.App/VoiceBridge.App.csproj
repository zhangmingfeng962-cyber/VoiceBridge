<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>VoiceBridge</AssemblyName><Version>0.8.2</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Assets\voicebridge.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(PublishSingleFile)' == 'true'">true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(PublishSingleFile)' == 'true'">true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../VoiceBridge.Core/VoiceBridge.Core.csproj" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../third-party/*" Link="third-party/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest">
      <CopyToPublishDirectory Condition="'$(PublishSingleFile)' == 'true'">Never</CopyToPublishDirectory>
    </Content>
    <EmbeddedResource Include="../../third-party/*" LogicalName="VoiceBridge.Assets.%(Filename)%(Extension)" WithCulture="false" />
    <Resource Include="Assets/voicebridge.ico" />
    <Resource Include="Assets/voicebridge.png" />
    <EmbeddedResource Include="Assets/voicebridge.ico" LogicalName="VoiceBridge.Icons.App.ico" WithCulture="false" />
    <EmbeddedResource Include="Sharing/Web/*" LogicalName="VoiceBridge.Sharing.Web.%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>
</Project>
