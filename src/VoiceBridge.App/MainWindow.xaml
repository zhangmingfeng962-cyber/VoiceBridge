<Window x:Class="VoiceBridge.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="VoiceBridge 0.8.1 · 一起听，一起聊" Icon="Assets/voicebridge.ico" Width="850" Height="800" MinWidth="700" MinHeight="680" Background="#101927" WindowStartupLocation="CenterScreen">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="32,26,32,28">
   <DockPanel>
    <StackPanel Orientation="Horizontal"><Image Source="Assets/voicebridge.png" Width="54" Height="54" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/><StackPanel><TextBlock Text="VoiceBridge" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="把音乐带进频道，让交流继续。" Foreground="#9FACBF" Margin="0,6,0,0"/></StackPanel></StackPanel>
    <Border Background="#23384A" CornerRadius="12" Padding="12,6" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="Win11 · x64" Foreground="#8EDCCD"/></Border>
   </DockPanel>
   <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Button x:Name="StartupButton" Content="开机自启动：关" Click="Startup_Click" AutomationProperties.Name="开机自启动开关" ToolTip="开启后随当前用户登录 Windows 启动，自动收起到托盘；不会自动开启人声或音乐。请先把 EXE 放在固定位置。" Margin="0,0,14,0"/>
    <TextBlock x:Name="StartupStatusText" Grid.Column="1" Text="点击开启；请将 EXE 保留在固定位置。" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#9FACBF" FontSize="12"/>
   </Grid>
   <Border Background="#17332F" BorderBrush="#30665A" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,18,0,0">
    <StackPanel>
     <TextBlock Text="音乐房间 · 一起听，一起聊" FontSize="22" FontWeight="SemiBold"/>
     <TextBlock Text="邀请朋友进入 VoiceBridge 房间，边听立体声音乐边讲话。音乐与人声分别传送，无需虚拟声卡。" Foreground="#ADCCC4" TextWrapping="Wrap" Margin="0,8,0,14"/>
     <TextBlock Text="伴奏来源" Foreground="#D6E0EF" Margin="0,0,0,6"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
      <ComboBox x:Name="BroadcastPlayerBox" AutomationProperties.Name="独立分享音乐来源" Margin="0,0,12,8"/>
      <Button x:Name="BroadcastMusicButton" Grid.Column="1" Content="伴奏：关" Click="BroadcastMusic_Click" AutomationProperties.Name="房间伴奏独立开关" ToolTip="只暂停传给房间的音乐，朋友仍能讲话；不改变本机播放器音量。" Margin="0,0,0,8"/>
     </Grid>
     <DockPanel Margin="0,6,0,0"><TextBlock Text="伴奏音量" Foreground="#D6E0EF"/><TextBlock x:Name="BroadcastVolumeValue" Text="100%" HorizontalAlignment="Right"/></DockPanel>
     <Slider x:Name="BroadcastVolumeSlider" Minimum="0" Maximum="100" Value="100" ValueChanged="BroadcastVolume_Changed" AutomationProperties.Name="房间伴奏音量" ToolTip="只改变房间收到的音乐，不随讲话自动压低；不改变你的本地听音。"/>
     <CheckBox x:Name="BroadcastSeparateCheck" IsChecked="True" Content="避免重复听到音乐（开始时关闭兼容输出的音乐）" Foreground="#D6E0EF" Margin="0,6,0,8"/>
     <CheckBox x:Name="BroadcastQuickCheck" IsChecked="True" Content="创建临时互联网链接（测试服务，无账号）" Foreground="#D6E0EF" Margin="0,0,0,8"/>
     <TextBlock Text="已配置中继时只需 HTTPS 出站连接，朋友无需账号。音乐在本机加密，接收端解密；中继只暂存加密片段。默认约 2.4 秒接收缓冲，实际延迟还取决于网络。没有中继配置时仍可尝试原临时链接。" Foreground="#ADCCC4" FontSize="12" TextWrapping="Wrap"/>
     <WrapPanel Margin="0,8,0,0"><Button x:Name="BroadcastStartButton" Content="创建音乐房间" Click="BroadcastStart_Click" Background="#237B65"/><Button x:Name="BroadcastStopButton" Content="停止独立分享" Click="BroadcastStop_Click" Visibility="Collapsed"/><Button x:Name="BroadcastCopyButton" Content="邀请朋友" Click="BroadcastCopy_Click"/><Button x:Name="BroadcastRoomButton" Content="进入语音房间" Click="BroadcastRoom_Click"/><Button x:Name="BroadcastPreviewButton" Content="本机试听音乐" Click="BroadcastPreview_Click"/></WrapPanel>
     <TextBox x:Name="BroadcastLinkBox" IsReadOnly="True" Text="尚未创建链接" AutomationProperties.Name="音乐收听链接" Margin="0,8,0,0" Padding="8" Background="#102621" Foreground="#D6E0EF" BorderBrush="#30665A" TextWrapping="Wrap"/>
     <TextBlock x:Name="BroadcastStatusText" Text="创建后邀请朋友进入房间。房间默认关闭麦克风，点击开启后才能讲话。" Foreground="#ADCCC4" TextWrapping="Wrap" Margin="0,8,0,0"/>
     <Expander Header="连接统计与固定 HTTPS 地址" Foreground="#D6E0EF" Margin="0,10,0,0">
      <StackPanel Margin="0,8,0,0">
       <TextBlock x:Name="BroadcastStatsText" Text="未连接收听端。48 kHz 双声道 float32 PCM，每人约需 3.1 Mbps 上行，另有协议开销。" Foreground="#ADCCC4" FontSize="12" TextWrapping="Wrap"/>
       <TextBlock x:Name="BroadcastLocalText" Text="本机监听端口：未启动" Foreground="#ADCCC4" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,8"/>
       <TextBlock Text="已有 HTTPS 反向代理时，取消临时链接并开始分享，再填根地址。代理须转发到本机端口并支持 WebSocket；填地址不会代你配置服务器。" Foreground="#ADCCC4" FontSize="12" TextWrapping="Wrap"/>
       <TextBox x:Name="BroadcastHttpsBox" AutomationProperties.Name="固定 HTTPS 分享地址" Margin="0,8,0,8" Padding="8" Background="#102621" Foreground="#D6E0EF" BorderBrush="#30665A"/>
       <WrapPanel><Button x:Name="BroadcastHttpsButton" Content="使用固定 HTTPS 地址" Click="BroadcastHttps_Click"/><Button Content="独立分享使用说明" Click="BroadcastHelp_Click"/></WrapPanel>
      </StackPanel>
     </Expander>
    </StackPanel>
   </Border>
   <TextBlock Text="房间最多 8 人 · 主持人也需进入房间后开启麦克风。房间人声在浏览器里控制，伴奏音量和开关可用托盘或快捷键调节。" Foreground="#9FACBF" TextWrapping="Wrap" Margin="0,14,0,12"/>
   <Expander x:Name="LegacyExpander" Header="兼容原语音软件 · 虚拟麦克风与场景设置" Foreground="#D6E0EF"><StackPanel>
   <Border Background="#182437" CornerRadius="10" Padding="14" Margin="0,14,0,0">
    <StackPanel>
     <TextBlock Text="使用场景 · 每个软件分别保存" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ComboBox x:Name="ScenarioBox" AutomationProperties.Name="使用场景" SelectionChanged="Scenario_Changed" Margin="0,0,12,0" ToolTip="先全部停止再切换。场景只调整 VoiceBridge 参数；目标软件内部的处理需按说明确认。"/>
      <Button Grid.Column="1" Content="场景说明" Click="ScenarioHelp_Click"/>
      <Button x:Name="SaveScenarioButton" Grid.Column="2" Content="保存场景" Click="SaveScenario_Click" Margin="0"/>
     </Grid>
     <TextBlock x:Name="PeerStatusText" Text="尚未记录接收端试听结果。" Foreground="#9FACBF" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
     <Expander x:Name="ScenarioExpander" Header="音频参数、输出检查与试听记录" Foreground="#D6E0EF" Margin="0,10,0,0">
      <StackPanel Margin="0,10,0,0">
       <TextBlock x:Name="InputRoutingText" Text="默认输入状态：等待读取。" Foreground="#9FACBF" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
       <WrapPanel Margin="0,0,0,12"><Button x:Name="DefaultInputButton" Content="将虚拟麦克风设为默认输入" Click="DefaultInput_Click" ToolTip="备份后更改 Windows 的普通、媒体和通信默认输入，影响使用系统默认麦克风的软件。只在点击后执行；通话可能需要重新进入。"/><Button x:Name="RestoreInputButton" Content="恢复此前默认输入" Click="RestoreInput_Click"/></WrapPanel>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="音乐声道"/><ComboBox x:Name="ChannelModeBox" AutomationProperties.Name="音乐声道方式" SelectionChanged="ScenarioOption_Changed" ToolTip="默认保留立体声。单声道会改变立体声内容；左右相加可能抵消反相内容。"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="输出缓冲"/><ComboBox x:Name="BufferBox" AutomationProperties.Name="音频输出缓冲" SelectionChanged="ScenarioOption_Changed" ToolTip="增大缓冲可能减少本机调度断音，也会增加延迟；不能关闭平台降噪。"/></StackPanel>
       </Grid>
       <WrapPanel><Button x:Name="LocalRecordButton" Content="录制虚拟输出 10 秒" Click="LocalRecord_Click" ToolTip="只在点击后录制 CABLE Output，包含当前开启的人声和音乐。文件保存在你选择的位置。"/><Button x:Name="LocalPlayButton" Content="试听本地录音" Click="LocalPlay_Click" ToolTip="先暂停音乐播放器，避免两段声音叠加。程序通过正常耳机播放录音，不通过虚拟线缆播放。"/><Button x:Name="ConfirmPeerButton" Content="记录：对方试听正常" Click="ConfirmPeer_Click" ToolTip="仅记录你实际收到的反馈，不会自动检测或改变目标软件。参数改变后需要重新确认。"/></WrapPanel>
       <TextBlock x:Name="LocalCheckText" Text="本地录音只能检查送入平台之前的声音；接收端仍需实际试听。" Foreground="#9FACBF" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
       <TextBlock x:Name="CaptureTelemetryText" Text="捕获统计：未启动。" Foreground="#9FACBF" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
      </StackPanel>
     </Expander>
    </StackPanel>
   </Border>
   <Border Background="#1A293E" CornerRadius="10" Padding="16" Margin="0,20,0,18">
    <StackPanel><TextBlock x:Name="PlatformText" TextWrapping="Wrap"/><TextBlock Text="仅捕获选中的音乐播放器进程树。游戏、队友语音和播放器的本地输出都应选择耳机。" TextWrapping="Wrap" Foreground="#9FACBF" Margin="0,7,0,0"/></StackPanel>
   </Border>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0"><TextBlock Text="真实麦克风" FontWeight="SemiBold"/><ComboBox x:Name="MicrophoneBox" AutomationProperties.Name="真实麦克风" SelectionChanged="ScenarioOption_Changed"/><TextBlock Text="人声与音乐独立调节。不会播放自己的麦克风。" FontSize="12" Foreground="#9FACBF" TextWrapping="Wrap"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="虚拟设备的发送端" FontWeight="SemiBold"/><ComboBox x:Name="CableBox" AutomationProperties.Name="虚拟设备发送端" SelectionChanged="ScenarioOption_Changed"/><TextBlock Text="语音软件的麦克风请选择 CABLE Output。" FontSize="12" Foreground="#9FACBF" TextWrapping="Wrap"/></StackPanel>
   </Grid>
   <WrapPanel Margin="0,18,0,20"><Button x:Name="RefreshButton" Content="刷新设备" Click="Refresh_Click"/><Button x:Name="RepairButton" Content="修复播放路由" Click="Repair_Click" ToolTip="将错误指向 VB-CABLE 的默认播放改为当前正常听音设备，并保存备份。"/><Button Content="Windows 声音设置" Click="SoundSettings_Click"/><Button Content="导出诊断" Click="Diagnostics_Click"/></WrapPanel>
   <Border Background="#182437" CornerRadius="12" Padding="20">
    <StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="135"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><TextBlock Text="人声" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="MicrophoneButton" Grid.Column="1" Content="人声：关" Click="Microphone_Click" AutomationProperties.Name="人声独立开关" ToolTip="仅控制传给对方的人声；不影响音乐。" Background="#30445C"/><TextBlock x:Name="MicValue" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
     <Slider x:Name="MicSlider" Minimum="0" Maximum="200" Value="100" ValueChanged="Volume_Changed" AutomationProperties.Name="麦克风音量"/>
     <ProgressBar x:Name="MicMeter" Minimum="0" Maximum="1" Height="5" BorderThickness="0" Foreground="#84CBFF" Background="#293951"/>
     <TextBlock Text="音乐来源" FontSize="18" FontWeight="SemiBold" Margin="0,20,0,8"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="135"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><ComboBox x:Name="MusicPlayerBox" AutomationProperties.Name="音乐播放器" SelectionChanged="MusicPlayer_Changed" ToolTip="选择 QQ音乐、网易云音乐或酷狗音乐。切换前请先点击“全部停止”。" Margin="0,0,16,0"/><Button x:Name="ShareButton" Grid.Column="1" Content="音乐：关" Click="Share_Click" AutomationProperties.Name="音乐独立开关" ToolTip="仅控制传给对方的音乐；不改变你耳机里的播放。" Background="#24433F"/><TextBlock x:Name="MusicValue" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
     <Slider x:Name="MusicSlider" Minimum="0" Maximum="100" Value="35" ValueChanged="Volume_Changed" AutomationProperties.Name="音乐共享音量"/>
     <ProgressBar x:Name="MusicMeter" Minimum="0" Maximum="1" Height="5" BorderThickness="0" Foreground="#71E0C0" Background="#293951"/>
     <TextBlock x:Name="ProcessText" Text="等待打开选中的音乐播放器" Margin="0,12,0,16" Foreground="#9FACBF"/>
     <Button x:Name="StartButton" Content="启动人声" Click="Start_Click" Background="#3456C5" FontSize="16" Margin="0"/>
     <TextBlock x:Name="StatusText" Text="点击任一路开关即可开始。两路都关闭时停止音频采集。" Foreground="#9FACBF" TextWrapping="Wrap" Margin="0,14,0,0"/>
    </StackPanel>
   </Border>
   <TextBlock Text="关闭或最小化窗口后在托盘继续运行；右键托盘图标可控制声音或退出。" Margin="0,12,0,0" Foreground="#9FACBF" TextWrapping="Wrap"/>
   <TextBlock x:Name="HotkeyText" Text="Ctrl+Alt+F8 人声 · Ctrl+Alt+F9 音乐 · Ctrl+Alt+↑/↓ 音乐音量" Margin="0,8,0,0" Foreground="#AEBBD2" TextWrapping="Wrap"/>
   <TextBlock x:Name="TelemetryText" Text="音乐使用固定增益，不随说话自动压低；实际接收音质取决于语音平台。" Margin="0,8,0,12" Foreground="#7F90AA" TextWrapping="Wrap"/>
   <WrapPanel Margin="0,0,0,18"><Button x:Name="StableVolumeButton" Content="关闭通话自动压低音量" Click="StableVolume_Click"/><Button Content="各平台音质设置" Click="QualityHelp_Click"/><Button Content="第三方许可" Click="Licenses_Click"/></WrapPanel>
   <Border Background="#182437" CornerRadius="10" Padding="16">
    <StackPanel>
     <DockPanel><TextBlock Text="虚拟音频组件 · VB-CABLE" FontWeight="SemiBold"/><Button x:Name="InstallButton" Content="打开官方安装器" Click="Install_Click" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="15,0,0,0"/></DockPanel>
     <TextBlock Text="原厂签名安装包已随软件附带。安装需要管理员授权，按原厂提示完成后重启；安装可能改变系统默认设备，请改回耳机。" Foreground="#9FACBF" TextWrapping="Wrap" Margin="0,10,0,8"/>
     <TextBlock Foreground="#9FACBF" TextWrapping="Wrap">VB-CABLE 来自 <Hyperlink NavigateUri="https://vb-audio.com/Cable/" RequestNavigate="Link_Click">VB-Audio</Hyperlink>，采用 donationware。发现有用时，请向原作者<Hyperlink NavigateUri="https://shop.vb-audio.com/en/win-apps/11-vb-cable.html" RequestNavigate="Link_Click">捐赠或购买许可</Hyperlink>。企业分发请遵守<Hyperlink NavigateUri="https://vb-audio.com/Services/licensing.htm" RequestNavigate="Link_Click">原厂许可</Hyperlink>。</TextBlock>
    </StackPanel>
   </Border>
   <TextBlock Text="建议使用耳机。应用隔离可以避免数字回传；扬声器串入真实麦克风的声学回声仍可能发生。语音软件的降噪、自动增益与编码也可能改变音乐效果。" Foreground="#7F90AA" FontSize="12" TextWrapping="Wrap" Margin="0,16,0,0"/>
   </StackPanel></Expander>
  </StackPanel>
 </ScrollViewer>
</Window>
