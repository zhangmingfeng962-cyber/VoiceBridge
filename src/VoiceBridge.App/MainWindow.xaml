<Window x:Class="VoiceBridge.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="VoiceBridge 0.12.0 · 游戏连麦" Icon="Assets/voicebridge.ico" Width="1060" Height="760" MinWidth="800" MinHeight="580" WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Border Background="#111111" Grid.RowSpan="2"><DockPanel Margin="18,24,12,18">
  <StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal" Margin="0,0,0,30"><Image Source="Assets/voicebridge.png" Width="32" Height="32" Margin="0,0,8,0"/><TextBlock Text="VoiceBridge" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><Button Content="房间大厅" Click="Lobby_Click" HorizontalContentAlignment="Left" Margin="0,0,0,10"/><Button x:Name="CurrentRoomButton" Content="我的房间" Click="Current_Click" Margin="0,0,0,10" IsEnabled="False"/><Button Content="创建房间" Style="{StaticResource Primary}" Click="Create_Click" Margin="0,8,0,10"/><TextBlock x:Name="ConnectionText" Text="还没有加入房间" Style="{StaticResource Muted}" Margin="8,12,4,0"/></StackPanel>
  <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="你的昵称" Style="{StaticResource Muted}"/><TextBox x:Name="NicknameBox" MaxLength="20" LostFocus="Nickname_LostFocus" AutomationProperties.Name="你的昵称"/><Button x:Name="UpdateButton" Content="检查更新" Click="Update_Click" Margin="0,4,0,10" FontSize="12"/><TextBlock Text="0.12.0" Style="{StaticResource Muted}" Margin="8,0,0,0"/><Button Content="退出程序" Click="Exit_Click" Background="Transparent" HorizontalAlignment="Left" FontSize="12" Margin="0,12,0,0"/></StackPanel><Border/>
 </DockPanel></Border>
 <Grid Grid.Column="1" Margin="24,24,24,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,20"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="设置" Click="Settings_Click"/><Button x:Name="CopyButton" Content="邀请朋友" Click="Copy_Click" IsEnabled="False"/></StackPanel><StackPanel><TextBlock x:Name="ViewTitle" Text="房间大厅" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="ViewHint" Text="找个房间，和朋友开黑。" Foreground="#B8B8B8" Margin="0,6,0,0" FontSize="12"/></StackPanel></DockPanel>
  <Grid x:Name="LobbyView" Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><Button DockPanel.Dock="Right" Content="刷新" Click="Refresh_Click"/><TextBox x:Name="SearchBox" TextChanged="Search_Changed" Margin="0,0,12,16" AutomationProperties.Name="搜索房间" ToolTip="搜索房间名或房主"/></DockPanel>
   <Grid Grid.Row="1"><ListBox x:Name="RoomList"><ListBox.ItemTemplate><DataTemplate><Border Background="#111111" Padding="18,14" CornerRadius="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding OwnerName,StringFormat=房主：{0}}" Style="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Count,StringFormat={}{0} / 8 人}" Margin="16,0" VerticalAlignment="Center"/><Button Grid.Column="2" Content="进入房间" Click="EnterPublic_Click" Tag="{Binding Id}" Margin="0"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="EmptyLobbyText" Text="还没有公开房间。创建一个房间，与朋友碰面。" Style="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid>
   <StackPanel Grid.Row="2" Margin="0,20,0,0"><TextBlock Text="通过邀请加入" FontSize="14"/><DockPanel Margin="0,8,0,0"><Button DockPanel.Dock="Right" Content="加入" Click="Join_Click" Margin="10,0,0,12"/><TextBox x:Name="InviteBox" Margin="0,0,0,12" AutomationProperties.Name="房间邀请" ToolTip="粘贴朋友的邀请或公开房间链接"/></DockPanel></StackPanel>
  </Grid>
  <Grid x:Name="RoomView" Grid.Row="1" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="MemberList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="#111111" CornerRadius="8" Padding="16" Margin="0,0,12,12" Width="215"><StackPanel><DockPanel><Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17" Background="#2A2A2A" Margin="0,0,10,0"><TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/></Border><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></DockPanel><ProgressBar Minimum="0" Maximum="1" Value="{Binding Peak,Mode=OneWay}" Height="3" Foreground="#80C9D5" Background="#2A2A2A" BorderThickness="0" Margin="0,16,0,12"/><Expander Header="我的收听音量" Foreground="#B8B8B8" Visibility="{Binding GainVisibility}"><StackPanel Margin="0,8,0,0"><TextBlock Text="{Binding VoiceGain,StringFormat=人声 {0:0}%}" Style="{StaticResource Muted}"/><Slider Maximum="200" Value="{Binding VoiceGain,Mode=TwoWay}"/><TextBlock Text="{Binding MusicGain,StringFormat=音乐 {0:0}%}" Style="{StaticResource Muted}"/><Slider Maximum="100" Value="{Binding MusicGain,Mode=TwoWay}"/><Button Content="移出房间" Tag="{Binding Id}" Click="Kick_Click" Visibility="{Binding KickVisibility}" FontSize="12"/></StackPanel></Expander></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
   <StackPanel Grid.Column="1" Margin="12,0,0,0"><Border Background="#111111" Padding="16" CornerRadius="8"><StackPanel><TextBlock Text="我的音乐" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="SourceCountText" Text="正在查找本机音源" Style="{StaticResource Muted}" Margin="0,8,0,12"/><ComboBox x:Name="SourceBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Source_Changed" AutomationProperties.Name="音乐来源"/><Button x:Name="MusicButton" Content="开始共享音乐" Click="Music_Click" Margin="0,14,0,8"/><TextBlock x:Name="MusicGainText" Text="音乐 100%" Style="{StaticResource Muted}"/><Slider x:Name="MusicGainSlider" Maximum="100" Value="100" ValueChanged="Gain_Changed" AutomationProperties.Name="我的音乐音量"/><TextBlock Text="只分享所选程序，讲话不会压低音乐。" Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border><Border Background="#111111" Padding="16" CornerRadius="8" Margin="0,16,0,0"><StackPanel><TextBlock Text="屏幕共享" FontSize="16"/><TextBlock Text="打开独立画面页，连麦继续留在软件中。" Style="{StaticResource Muted}" Margin="0,8,0,12"/><Button x:Name="OpenButton" Content="打开画面页" Click="Open_Click" Margin="0"/></StackPanel></Border><Button x:Name="ManageButton" Content="管理房间" Click="Manage_Click" Margin="0,16,0,0" Visibility="Collapsed"/></StackPanel>
  </Grid>
  <TextBlock x:Name="StatusText" Grid.Row="2" Text="国内服务已内置，进入房间即可连麦。" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
 </Grid>
 <Border Grid.Column="1" Grid.Row="1" Background="#111111" Padding="20,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><Button x:Name="MicButton" Content="开启麦克风" Click="Mic_Click" IsEnabled="False" Style="{StaticResource Primary}" Margin="0"/><ComboBox x:Name="TalkModeBox" SelectedIndex="0" SelectionChanged="TalkMode_Changed" MinHeight="30" Width="116" HorizontalAlignment="Left" FontSize="12" Margin="0,6,0,0" AutomationProperties.Name="发言方式"><ComboBoxItem Content="自由发言"/><ComboBoxItem Content="按键说话"/></ComboBox></StackPanel><StackPanel Grid.Column="1" Margin="0,0,16,0"><DockPanel><TextBlock x:Name="MicGainText" Text="麦克风 100%" FontSize="12"/></DockPanel><Slider x:Name="MicGainSlider" Maximum="400" Value="100" ValueChanged="Gain_Changed" AutomationProperties.Name="麦克风增益"/></StackPanel><StackPanel Grid.Column="2" Margin="0,0,16,0"><TextBlock x:Name="SpeakerGainText" Text="房间收听 100%" FontSize="12"/><Slider x:Name="SpeakerGainSlider" Maximum="200" Value="100" ValueChanged="Gain_Changed" AutomationProperties.Name="房间收听音量"/></StackPanel><Button Grid.Column="3" x:Name="LeaveButton" Content="退出房间" Click="Leave_Click" IsEnabled="False" Background="Transparent" Foreground="#DDB975"/></Grid></Border>
 <Border x:Name="Drawer" Grid.Column="1" Background="#111111" BorderBrush="#555555" BorderThickness="1,0,0,0" HorizontalAlignment="Right" Width="330" Padding="24" Visibility="Collapsed"><DockPanel><Button DockPanel.Dock="Top" Content="关闭设置" Click="CloseDrawer_Click" HorizontalAlignment="Right" Margin="0,0,0,22"/><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><StackPanel x:Name="CreatePanel" Visibility="Collapsed"><TextBlock Text="创建房间" FontSize="24"/><TextBlock Text="房间名" Margin="0,22,0,0"/><TextBox x:Name="RoomNameBox" MaxLength="32" AutomationProperties.Name="房间名"/><CheckBox x:Name="PublicRoomCheck" Content="公开到房间大厅"/><TextBlock Text="公开后，访问大厅的人可以加入。私密房间仅凭邀请进入。" Style="{StaticResource Muted}" Margin="0,8,0,18"/><Button x:Name="SubmitCreateButton" Content="创建并进入" Click="SubmitCreate_Click" Style="{StaticResource Primary}"/></StackPanel>
 <StackPanel x:Name="ManagePanel" Visibility="Collapsed"><TextBlock Text="管理房间" FontSize="24"/><TextBlock Text="房间名" Margin="0,22,0,0"/><TextBox x:Name="ManageNameBox" MaxLength="32"/><CheckBox x:Name="ManagePublicCheck" Content="公开到房间大厅"/><Button Content="保存房间设置" Click="SaveManage_Click" Margin="0,16,0,0"/></StackPanel>
 <StackPanel x:Name="SettingsPanel"><TextBlock Text="音频设置" FontSize="24"/><TextBlock Text="麦克风" Margin="0,24,0,8"/><ComboBox x:Name="MicrophoneBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Device_Changed" AutomationProperties.Name="真实麦克风"/><TextBlock Text="耳机或扬声器" Margin="0,20,0,8"/><ComboBox x:Name="OutputBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Device_Changed" AutomationProperties.Name="耳机或扬声器"/><Button x:Name="NoiseButton" Content="麦克风降噪：开" Click="Noise_Click" Margin="0,22,0,12"/><Button x:Name="KeyButton" Content="说话键：V" Click="BindKey_Click" Margin="0,0,0,12"/><TextBlock Text="降噪只处理麦克风。按键说话在游戏后台同样有效。" Style="{StaticResource Muted}"/><TextBlock x:Name="UpdateNotes" Style="{StaticResource Muted}" Margin="0,22,0,0"/><Button Content="立即检查更新" Click="CheckUpdate_Click" Margin="0,28,0,0"/></StackPanel></StackPanel></ScrollViewer></DockPanel></Border>
</Grid></Window>
